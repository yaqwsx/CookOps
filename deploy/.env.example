# Copy to .env and replace every placeholder with deployment secrets.
POSTGRES_DB=cookops
POSTGRES_USER=cookops
POSTGRES_PASSWORD=replace-with-postgres-password
COOKOPS_API_DB_PASSWORD=replace-with-url-safe-api-db-password
OAUTH_DB_PASSWORD=replace-with-url-safe-oauth-db-password
COOKOPS_GOOGLE_CLIENT_ID=replace-with-google-client-id
COOKOPS_BROWSER_SESSION_HMAC_KEY=replace-with-32-byte-base64url-key
COOKOPS_BROWSER_ORIGIN=https://cookops.example
COOKOPS_TRUSTED_PROXY_IPS=replace-with-apache-source-ip
OAUTH_ISSUER=https://cookops.example/oauth
MCP_RESOURCE=https://cookops.example/mcp
OAUTH_INTERACTION_URL=https://cookops.example/auth/mcp-interactions
OAUTH_COOKIE_KEYS=replace-with-first-32-character-secret,replace-with-second-32-character-secret
OAUTH_RESOURCE_SERVER_SECRET=replace-with-32-character-resource-server-secret
OAUTH_JWKS={"keys":[{"kty":"EC","crv":"P-256","d":"replace-with-private-jwk-material","x":"replace","y":"replace"}]}
OAUTH_ADAPTER_SECRET_BASE64URL=replace-with-32-byte-base64url-key
OAUTH_INTERACTION_APPROVAL_SECRET_BASE64URL=replace-with-32-byte-base64url-key
OAUTH_APPROVAL_API_CREDENTIAL_BASE64URL=replace-with-32-byte-base64url-key
OAUTH_INTERACTION_DETAILS_API_CREDENTIAL_BASE64URL=replace-with-a-different-32-byte-base64url-key
COOKOPS_PUBLIC_ORIGIN=https://cookops.example
