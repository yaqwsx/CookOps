# Requires: proxy, proxy_http, headers, rewrite and ssl (Apache 2.4.47+).
# Replace the certificate paths and cookops.example before enabling this vhost.
<VirtualHost *:80>
    ServerName cookops.example
    RewriteEngine On
    RewriteRule ^ https://cookops.example%{REQUEST_URI} [R=301,L,NE]
</VirtualHost>

<VirtualHost *:443>
    ServerName cookops.example
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/cookops.example/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/cookops.example/privkey.pem

    ProxyRequests Off
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Host "cookops.example"
    LimitRequestBody 20971520

    # API routes must precede the single-page application catch-all route.
    ProxyPass        /health/ http://127.0.0.1:8000/health/
    ProxyPassReverse /health/ http://127.0.0.1:8000/health/
    # Only the browser consent UI is public; grant management stays private.
    ProxyPass        /auth/mcp-interactions/ http://127.0.0.1:8000/auth/mcp-interactions/
    ProxyPassReverse /auth/mcp-interactions/ http://127.0.0.1:8000/auth/mcp-interactions/
    ProxyPass        /auth/mcp-grants !
    ProxyPass        /auth/ http://127.0.0.1:8000/auth/
    ProxyPassReverse /auth/ http://127.0.0.1:8000/auth/
    # The interaction completion flow needs the protocol service. MCP stays absent
    # until FastAPI has the separately versioned resource-token verifier.
    ProxyPass        /oauth/private !
    ProxyPass        /.well-known/openid-configuration/oauth http://127.0.0.1:3000/.well-known/openid-configuration/oauth
    ProxyPassReverse /.well-known/openid-configuration/oauth http://127.0.0.1:3000/.well-known/openid-configuration/oauth
    ProxyPass        /.well-known/oauth-authorization-server/oauth http://127.0.0.1:3000/.well-known/oauth-authorization-server/oauth
    ProxyPassReverse /.well-known/oauth-authorization-server/oauth http://127.0.0.1:3000/.well-known/oauth-authorization-server/oauth
    ProxyPass        /oauth/ http://127.0.0.1:3000/oauth/
    ProxyPassReverse /oauth/ http://127.0.0.1:3000/oauth/
    ProxyPass        /api/v1/sync/hints http://127.0.0.1:8000/api/v1/sync/hints upgrade=websocket
    ProxyPassReverse /api/v1/sync/hints http://127.0.0.1:8000/api/v1/sync/hints
    ProxyPass        /api/ http://127.0.0.1:8000/api/
    ProxyPassReverse /api/ http://127.0.0.1:8000/api/
    ProxyPass        /media/ http://127.0.0.1:8000/media/
    ProxyPassReverse /media/ http://127.0.0.1:8000/media/

    ProxyPass        / http://127.0.0.1:8080/
    ProxyPassReverse / http://127.0.0.1:8080/

    <LocationMatch "^/(?:$|index\\.html$|sw\\.js$|registerSW\\.js$|runtime-config\\.js$)">
        Header always set Cache-Control "no-cache"
    </LocationMatch>
    <LocationMatch "^/assets/">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </LocationMatch>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</VirtualHost>
